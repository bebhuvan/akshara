    "row_group": "",
    "row_label": "1847",
    "column_index": 4,
    "column_header": "Column 4",
    "raw_text": "This was a year of great famine, and scarcity of water and food to men and animals. The then Government procured grain, opened grain shops, and supplied each family with the requisite quantity of grain as far as possible, but the supply not being sufficient, large numbers of men and animals began to die; so the people with their cattle fled to Malwa, where several of them died, and others returned on the return of the monsoon.",
    "value_numeric": null,
    "unit": "",
    "is_null_or_leader": false,
    "arithmetic_verified": false
  },
