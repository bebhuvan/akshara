  {
    "book_id": "report-past-famines-bombay-etheridge-1868",
    "table_id": "tbl-019",
    "caption": "“Famine Report of the Pergunnahs of Olpar and Unclesir, including Hansote.",
    "page_number": 74,
    "printed_folio": "60",
    "row_index": 18,
    "row_role": "data",
    "row_group": "",
    "row_label": "1897",
    "column_index": 4,
    "column_header": "Column 4",
    "raw_text": "No great famine has taken place since the accession of the British Government. In Sumvut 1874, A. D. 1818, however, in some years crops were injured owing to the scarcity of rain, or the overflowing of the river. In such times as this Government allowed remissions of rent to the cultivators, and made donations to enable the people to build houses. Government also found work for the people by opening public works, such as sinking and repairing wells, clearing tanks, &c., so the people had not to fly for grain to other provinces. The price of grain and other necessaries of life between the Sumvut 1816 and 1821 was not better than the famine prices in the years preceding the accession of the British power, and, though the prices have declined since the Sumvut 1822, the decrease is only slight.",
    "value_numeric": null,
    "unit": "",
    "is_null_or_leader": false,
    "arithmetic_verified": false
  }
