# Security and cache headers for every response. Cloudflare reads this file (see DECISIONS.md, D3).
# Scripts run only from this site; 'wasm-unsafe-eval' lets the search index (Pagefind) run its
# WebAssembly. Inline style attributes carry each plate's address, a cover's crop and the reader's text size;
# <style> elements and stylesheets may come only from this site (style-src-elem; browsers without it fall
# back to style-src). Scans load from archive.org. Cloudflare Web Analytics adds its beacon to every page; the
# beacon loads from static.cloudflareinsights.com and reports to cloudflareinsights.com (DECISIONS.md, D32).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'sha256-gPb+ADz8qe+VtwoqvN2ocYKZ/fbOHo0PeBjCwa/Qd1w='; style-src-attr 'unsafe-inline'; img-src 'self' data: https://archive.org https://*.archive.org; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Stylesheets and scripts are fingerprinted (the file name changes with the content), so they can be kept a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# These keep their names when they change, so browsers check back daily.
/covers/*
  Cache-Control: public, max-age=86400
/figures/*
  Cache-Control: public, max-age=86400
/plates/*
  Cache-Control: public, max-age=86400
/og/*
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=2592000
# The search index: its chunks are named by their content, so they can be kept a year. The files that point
# at them keep their names, so browsers must check them on every visit; a cached pagefind-entry.json once
# pointed at chunks a new deploy had removed, and search failed until the cache ran out.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/pagefind-entry.json
  Cache-Control: public, max-age=0, must-revalidate
/pagefind/pagefind.js
  Cache-Control: public, max-age=0, must-revalidate
/pagefind/pagefind-worker.js
  Cache-Control: public, max-age=0, must-revalidate
/pagefind/wasm.*
  Cache-Control: public, max-age=0, must-revalidate

# The opening page advertises the API catalog (RFC 9727), LLM index, and sitemap in HTTP Link headers.
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="describedby"; type="text/markdown", </sitemap.xml>; rel="sitemap"; type="application/xml"

# RFC 9727 Well-Known API Catalog (application/linkset+json)
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/opensearch.xml
  Content-Type: application/opensearchdescription+xml; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# Machine-readable catalog and LLM endpoints: open CORS so researchers, notebooks and agents can fetch them directly.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
/catalog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
/data/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Downloads remain crawlable/fetchable for readers, AI agents and Google Dataset Search,
# but X-Robots-Tag keeps raw single-page HTML/Markdown/XML/CSV dumps from cannibalising
# the canonical /books/ and chapter pages in search results.
/downloads/*
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex, follow
  Access-Control-Allow-Origin: *
